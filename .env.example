# Copy to `.env` at the repo root. `docker compose` reads it automatically.

# ---- Vault ----
# Bind-mounted read/write into the backend container.
VAULT_PATH=/Users/dileep/Documents/Obsedian/dilleep-personal/Dileep-Personal
JOURNAL_SUBDIR=Journal

# ---- Frontend build-time URL ----
# What the browser will hit to reach the backend. Localhost works on the host machine.
NEXT_PUBLIC_API_URL=http://localhost:8787

# ---- Optional LLM env vars (in-app Settings → LLM works too) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Only if using the LiteLLM proxy path ----
LLM_PROXY_URL=http://llm-proxy:4000
DEFAULT_MODEL=copilot-sonnet
