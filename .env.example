# Copy to .env (next to docker-compose.yml) and fill in.

# Auth: no env var to set here anymore. Auth is username/password now — the first
# time you open the app, you'll be prompted to create the one account for this
# instance. For MCP clients or scripts, generate an API token afterward in
# Settings -> Security -> API Tokens.

# OPTIONAL — override the host port (container always listens on 3000 internally).
LIFEOS_PORT=3000

# OPTIONAL — CORS allowlist. Add tunnel hostnames here if browsers connect from them.
# LIFEOS_CORS_ORIGIN=https://lifeos.mydomain.com

# OPTIONAL — Obsidian vault (host path). If unused, the compose file mounts an
# empty directory as /vault so the backend has somewhere to write.
# VAULT_PATH=/Users/dileep/Documents/Obsidian/personal
JOURNAL_SUBDIR=Journal

# OPTIONAL — container timezone so day-based aggregates match your wall clock.
# Defaults to UTC. Format: IANA zone (e.g. Asia/Kolkata, Europe/Berlin, America/New_York).
# TZ=Asia/Kolkata
